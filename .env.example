# Postgres connection string. `npm run db:start` starts a matching local database via Docker.
DATABASE_URL="postgres://root:mysecretpassword@localhost:5432/local"

# Secret used to sign sessions and tokens. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Public URL of the app. Used to build the links in password reset emails.
BETTER_AUTH_URL="http://localhost:5173"

# Resend API key for sending password reset emails.
# Optional in development: without it, reset links are printed to the server console.
RESEND_API_KEY=""

# Sender address. Resend only delivers from a domain you have verified;
# onboarding@resend.dev can only send to your own Resend account email.
EMAIL_FROM="Hangul Learning <onboarding@resend.dev>"
